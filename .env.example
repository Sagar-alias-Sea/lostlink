# LostLink Environment Configuration Example

# SQLite (Local default)
DATABASE_URL="file:./dev.db"

# Or PostgreSQL (Cloud / Production e.g. Supabase, Neon, Render)
# DATABASE_URL="postgresql://user:password@host:5432/lostlink?schema=public"

# JWT Secret for cookie authentication (generate a strong random string in production)
JWT_SECRET="lostlink-super-secure-production-jwt-secret-key-2026"

# Node Environment
NODE_ENV="production"

# App Public URL
NEXT_PUBLIC_APP_URL="https://lostlink.example.com"
